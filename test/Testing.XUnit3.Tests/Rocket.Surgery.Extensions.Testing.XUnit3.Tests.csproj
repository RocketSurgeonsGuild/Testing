<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <!-- The generators, analyzers and code fixes in Generators/ are test fixtures for the generator harness: they target the test TFMs and never ship. -->
        <NoWarn>$(NoWarn);RS1036;RS1016;RS1041;RS2008</NoWarn>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- TUnit.Mocks brings in TUnit.Core, but this project runs on xUnit: keep TUnit's global usings and test discovery generator out. -->
        <TUnitImplicitUsings>false</TUnitImplicitUsings>
        <EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Verify.XUnitV3" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="TUnit.Mocks" />
        <!-- The Fake/ tests exercise the AutoFakeTest (FakeItEasy) integration itself, so they keep using FakeItEasy. -->
        <PackageReference Include="FakeItEasy" />
        <PackageReference Include="xunit.analyzers" />
        <PackageReference Include="Serilog.Sinks.Spectre" />
        <PackageReference Include="Verify.SourceGenerators" />
        <Using Include="Xunit" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Testing.NSubstitute\Rocket.Surgery.Extensions.Testing.NSubstitute.csproj" />
        <ProjectReference Include="..\..\src\Testing.FakeItEasy\Rocket.Surgery.Extensions.Testing.FakeItEasy.csproj" />
        <ProjectReference Include="..\..\src\Testing.SourceGenerators\Rocket.Surgery.Extensions.Testing.SourceGenerators.csproj" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Testing.XUnit3\Rocket.Surgery.Extensions.Testing.XUnit3.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content CopyToOutputDirectory="PreserveNewest" Include="Fixtures/**/*.csproj;Fixtures/**/*.props;Fixtures/**/*.targets" />
        <Compile Remove="Fixtures/**/*.cs" />
    </ItemGroup>
</Project>
