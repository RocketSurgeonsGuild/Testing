amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/builtins/test/helpers.pkl"

// Solution the .NET formatters operate against.
local solution = "Testing.slnx"

local excludeDiagnostics = new Listing<String> {
  "CA1869"
  "CA2255"
  "CS0103"
  "CS0108"
  "CS1061"
  "CS0246"
  "CS1591"
  "CS8602"
  "CS8604"
  // A nullable annotation outside a nullable context: reported when the formatter's workspace evaluates a project without its Nullable
  // setting (CI's does for the samples), and "fixed" by stripping the annotation, which changes what HotChocolate infers.
  "CS8632"
  "IDE0052"
  "IDE0060"
  "IDE0130"
  "IDE1006"
  "RCS1060"
  "RCS1075"
  "RCS1093"
  "RCS1110"
  "RCS1112"
  "RCS1163"
  "RCS1175"
  "RCS1246"
  "RCS1250"
  "RCS1251"
  "RCS1264"
  "RS0026"
}

local excludes =
  List(
    "**/obj/**/*",
    "**/bin/**/*",
    ".git/**/*",
    ".vs/**/*",
    ".vscode/**/*",
    ".idea/**/*",
    ".claude/**/*",
    ".agents/**/*",
    ".apm/**/*",
    ".copilot/**/*",
    ".squad/**/*",
    "**/*.verified.*",
    "**/*.received.*",
  )

local yamlTest = new helpers.TestMaker { filename = "foo.yml" }
local badYaml = "key:   value\nlist:\n    -   item\n"
local goodYaml = "key: value\nlist:\n  - item\n"

local excludedDiagnosticsString = excludeDiagnostics.join(" ")

// `dotnet format` — whitespace / code-style / analyzer fixes, scoped to the changed C# files.
// Has a real verify mode, so it can run in `check` as well as `fix`.
local dotnetFormat: Step = new Step {
  glob = "**/*.cs"
  check =
    "dotnet format \(solution) --exclude-diagnostics \(excludedDiagnosticsString) --verify-no-changes --include {{files}}"
  fix =
    "dotnet format \(solution) --exclude-diagnostics \(excludedDiagnosticsString) --include {{files}}"
}

// JetBrains ReSharper `cleanupcode` (`jb` global tool, resolved via mise).
// Fix-only: cleanupcode rewrites files in place and has no verify mode, so we only set `fix`.
// `--include` wants a `;`-separated list of relative paths.
// Sequenced after dotnet-format and made exclusive so the two don't race on the same .cs files.
// To pin a profile/settings add e.g. --profile="Built-in: Reformat Code" --settings="<solution>.DotSettings".
local jbCleanupCode: Step = new Step {
  glob = List("**/*.cs")
  exclusive = true
  depends = new Listing<String> { "dotnet-format" }
  fix = "jb cleanupcode \(solution) --include=\"{{ files | replace(from=\" \", to=\";\") }}\""
}

steps {
  ["mise"] = Builtins.mise
  ["biome"] = Builtins.biome
  ["tombi"] = Builtins.tombi
  ["tombi-format"] = Builtins.tombi_format
  ["xmllint"] = Builtins.xmllint
  // The schema the GraphQL sample's build writes keeps the BOM the build gives it; stripping it here only makes the next build put it back.
  ["byte-order-marker"] = (Builtins.byte_order_marker) {
    exclude = List("test/Sample.Graphql.Tests/schema.graphql")
  }
  ["case-conflict"] = Builtins.check_case_conflict
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["symlinks"] = Builtins.check_symlinks
  ["hk-test"] = Builtins.hk_test
  ["pkl-format"] = Builtins.pkl_format
  // Validate the hand-authored GitHub Actions workflows (.github/workflows/*.yml).
  ["actionlint"] = Builtins.actionlint
  // Safety nets (no external binaries required).
  ["detect-private-key"] = Builtins.detect_private_key
  ["large-files"] = Builtins.check_added_large_files
  ["dotnet-format"] = dotnetFormat
  // YAML, Markdown and CSS/HTML only: biome formats JS/TS/JSON and tombi formats TOML. Style and ignores live in .oxfmtrc.json.
  ["oxfmt"] = (Builtins.oxfmt) {
    glob =
      List(
        "**/*.yml",
        "**/*.yaml",
        "**/*.md",
        "**/*.mdx",
        "**/*.markdown",
        "**/*.css",
        "**/*.scss",
        "**/*.html",
        "**/*.htm",
      )
    // The builtin's tests format a .ts file, which this glob leaves to biome; test the same way with YAML.
    tests = new {
      ["check bad file"] = yamlTest.checkFail(badYaml, 1)
      ["check good file"] = yamlTest.checkPass(goodYaml)
      ["fix bad file"] = yamlTest.fixPass(badYaml, goodYaml)
      ["diff bad file"] = yamlTest.diffPass(badYaml, goodYaml)
    }
  }
  // ["jb-cleanupcode"] = jbCleanupCode
}

exclude = excludes

hooks {
  // Local commits apply the fixes and stage them. Unstaged edits are stashed first, so a fixer only rewrites what's being committed
  // and the unstaged rest isn't swept into the commit. There's deliberately no pre-push hook: fixes happen at commit time, and CI
  // fixes the PR.
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
    steps {
      // `hk test` runs each builtin's tests in scratch git repositories, and inside a git hook the GIT_DIR / GIT_WORK_TREE git
      // exports point those at this repository instead (from a worktree they wrote core.worktree into the shared .git/config).
      // It still runs in `hk check`, `hk fix` and CI.
      ["hk-test"] = (Builtins.hk_test) {
        step_condition = "false"
      }
    }
  }
}
