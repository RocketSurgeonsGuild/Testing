<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <IsTestProject>false</IsTestProject>
        <RootNamespace>Rocket.Surgery.Extensions.Testing</RootNamespace>
        <IsMagicProject>true</IsMagicProject>
        <PackageTags>$(PackageTags);tunit;test-context;logging;serilog</PackageTags>
        <PackageDescription>TestRecord, the TUnit test context for LoggerTest&lt;TContext&gt;, which writes Serilog output to the current TUnit test's output.</PackageDescription>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BeaKona.AutoInterfaceGenerator" PrivateAssets="all" />
        <PackageReference Include="TUnit.Core" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Testing\Rocket.Surgery.Extensions.Testing.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="template.scriban" />
    </ItemGroup>
</Project>
