<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <IsTestProject>false</IsTestProject>
        <RootNamespace>Rocket.Surgery.Extensions.Testing</RootNamespace>
        <IsMagicProject>true</IsMagicProject>
        <PackageTags>$(PackageTags);fakeiteasy;mocking;auto-mocking;automock;dryioc;verify</PackageTags>
        <PackageDescription>AutoFakeTest&lt;TContext&gt; and AutoFake, a DryIoc container that resolves the class under test and fills in FakeItEasy fakes for dependencies it can't construct. Also initializes Verify.FakeItEasy.</PackageDescription>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Rocket.Surgery.Extensions.Testing.Tests" />
        <PackageReference Include="FakeItEasy" />
        <PackageReference Include="Verify.FakeItEasy" />
        <!-- Disabled for now to handle scenarios with enumerables -->
        <ProjectReference Include="../Testing/Rocket.Surgery.Extensions.Testing.csproj" PrivateAssets="contentfiles" />
    </ItemGroup>
    <ItemGroup>
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
    </ItemGroup>
</Project>
